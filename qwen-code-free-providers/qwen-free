                {
                    "id": "qwen3.6-plus",
                    "name": "Qwen3.6-Plus (FREE)",
                    "baseUrl": f"http://127.0.0.1:{port}/v1",
                    "description": "Qwen3.6-Plus via Free Bridge (NO API KEY NEEDED!)",
                    "envKey": "NO_KEY_NEEDED"
                },
                {
                    "id": "qwen3.5-plus",
                    "name": "Qwen3.5-Plus (FREE)",
                    "baseUrl": f"http://127.0.0.1:{port}/v1",
                    "description": "Qwen3.5-Plus via Free Bridge (NO API KEY NEEDED!)",
                    "envKey": "NO_KEY_NEEDED"
                },
                {
                    "id": "qwen3.5-flash",
                    "name": "Qwen3.5-Flash (FREE)",
                    "baseUrl": f"http://127.0.0.1:{port}/v1",
                    "description": "Qwen3.5-Flash via Free Bridge (NO API KEY NEEDED!)",
                    "envKey": "NO_KEY_NEEDED"
                },
                {
                    "id": "qwen3-coder-plus",
                    "name": "Qwen3-Coder-Plus (FREE)",
                    "baseUrl": f"http://127.0.0.1:{port}/v1",
