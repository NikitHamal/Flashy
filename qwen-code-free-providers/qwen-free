#!/usr/bin/env python3
"""
qwen-free CLI - A wrapper that starts the bridge server and configures qwen-code to use it.
This allows using qwen-code with FREE providers without any API keys!
"""

import argparse
import subprocess
import sys
import os
import time
import json
import signal
from pathlib import Path


def get_bridge_path():
    """Get the path to the bridge server."""
    return Path(__file__).parent / "bridge_server.py"


def get_settings_path():
    """Get the path to qwen-code settings."""
    home = Path.home()
    return home / ".qwen" / "settings.json"


def ensure_qwen_dir():
    """Ensure the .qwen directory exists."""
    qwen_dir = Path.home() / ".qwen"
    qwen_dir.mkdir(exist_ok=True)
    return qwen_dir


def write_free_provider_config(port=8787):
    """Write settings.json with free providers configuration."""
    settings_path = get_settings_path()
    ensure_qwen_dir()
    
    config = {
        "modelProviders": {
