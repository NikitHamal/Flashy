{
  "name": "flashy-desktop",
  "version": "0.1.0",
  "description": "Native desktop shell for Flashy",
  "author": "NikitHamal <iamnikithamal@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/NikitHamal/Flashy"
  },
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "dev": "electron .",
    "build:backend": "node scripts/build-backend.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {
    "electron-log": "^5.2.0"
  },
  "devDependencies": {
    "electron": "^32.2.8",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "dev.flashy.desktop",
    "productName": "Flashy",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
